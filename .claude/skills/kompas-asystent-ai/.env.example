# Skopiuj do .env (plik .env w .gitignore). Nigdy nie wpisuj kluczy do repozytorium ani do nagrania ekranu.

# ollama | openai_compat
LLM_PROVIDER=ollama
# ollama: http://localhost:11434 ; Groq: https://api.groq.com/openai/v1 ; Mistral: https://api.mistral.ai/v1 ;
# OpenRouter: https://openrouter.ai/api/v1 ; on-prem vLLM/llama.cpp z PLLuM/Bielikiem: http://<host>:8000/v1
LLM_BASE_URL=http://localhost:11434
# ollama: llama3.1:8b (szybszy na 6 GB VRAM) albo qwen2.5:14b ; Groq: openai/gpt-oss-120b ; Mistral: mistral-small-latest
LLM_MODEL=llama3.1:8b
# tylko dla openai_compat (z panelu dostawcy)
LLM_API_KEY=

# Embeddingi (retrieval) – domyślnie lokalna Ollama, także gdy czat idzie do API w chmurze
EMBED_PROVIDER=ollama
EMBED_BASE_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text

LLM_TIMEOUT=120
LLM_RETRIES=2
# 1 = zapisuj odpowiedzi w LLM_CACHE_DIR; LLM_REPLAY=1 = tylko z cache (demo offline, bez sieci i klucza)
LLM_CACHE=0
LLM_CACHE_DIR=.llm_cache
LLM_REPLAY=0
