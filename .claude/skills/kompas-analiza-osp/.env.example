# kompas-analiza-osp – zmienne środowiskowe (bez sekretów)
# Adres lokalnej Ollamy (propose_form.py --ollama MODEL)
OLLAMA_URL=http://localhost:11434
# Jak długo model zostaje w pamięci po wywołaniu (np. 5m; 0 = zwolnij od razu)
OLLAMA_KEEP_ALIVE=5m
# Limit czasu jednego wywołania w sekundach (qwen2.5:14b na 6 GB VRAM nie zmieścił się w 600 s)
OLLAMA_TIMEOUT=600
# Katalog z materiałami Partnera dla testów pytest (szukany OSP_word.zip)
KOMPAS_MATERIALY=materialy
